[resource]
script = ExtResource("1_el36n")
id = &"expediente_11"
title = "Expediente · Habitación 11"
kind = 1
date_text = "Marzo"
body = "PACIENTE: ████████
ESTADO: Fallecido en marzo. Cama vacía desde entonces.

OBSERVACIONES POSTERIORES (otra letra):
«La cama sigue caliente por las mañanas.»
«Las sábanas aparecen revueltas.»
«Hoy había una llave encima del colchón. No es de nadie.»"
