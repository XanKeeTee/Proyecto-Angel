[resource]
script = ExtResource("1_k82l8")
display_name = "Contundente"
summary = "Rompe huesos. En la cabeza aturde; si parte una pierna, derriba. No amputa."
limb_integrity_mult = 1.25
head_integrity_mult = 1.2
